# Copy to .env and adjust. Every value is optional.

# OPTIONAL (paid): Claude-powered AI Health Assistant.
# Leave empty to use the FREE offline knowledge engine (default).
ANTHROPIC_API_KEY=
HC_LLM_PROVIDER=auto            # auto | anthropic | offline
HC_ANTHROPIC_MODEL=claude-opus-5-5

# Security - leave empty to auto-generate and store in ./instance/
HC_JWT_SECRET=
HC_ENCRYPTION_KEY=

# Database (SQLite by default; PostgreSQL example: postgresql+psycopg://user:pass@host/db)
HC_DATABASE_URL=

HC_TOKEN_MINUTES=480            # registered-user session length
HC_DEMO_MINUTES=30              # demo session length
HC_MAX_UPLOAD_MB=10
